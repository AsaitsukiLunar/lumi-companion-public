<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\lumi.ico</ApplicationIcon>
    <AssemblyName>LumiCompanion</AssemblyName>
    <RootNamespace>LumiCompanion</RootNamespace>
    <Version>0.3.16-beta.1</Version>
    <FileVersion>0.3.16.0</FileVersion>
    <AssemblyVersion>0.3.16.0</AssemblyVersion>
    <Company>Lumi</Company>
    <Product>Lumi for Codex</Product>
    <Description>Offline-first independent Lumi desktop companion for Windows.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- WPF owns process DPI awareness through app.manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated output helpers are evidence artifacts, never application source. -->
    <Compile Remove="output\**\*.cs" />
    <Resource Include="assets\frames\**\*.png" />
    <Resource Include="assets\frames@2x\**\*.png" />
  </ItemGroup>
</Project>
